{
  "name": "dedup",
  "spec": "HTTP.md §2 Idempotency",
  "steps": [
    {
      "send": {
        "events": [
          {
            "protocol": 1,
            "id": "*",
            "type": "session.started",
            "time": "*",
            "tier": 0,
            "harness": {
              "name": "conformance",
              "event": "test"
            },
            "session": {
              "id": "conf-{run}",
              "seq": 0
            },
            "privacy": {
              "rulesets": [
                "secrets@1"
              ],
              "pii": false
            },
            "data": {
              "source": "startup"
            }
          }
        ]
      },
      "expect": {
        "status": 202,
        "body": {
          "accepted": 1,
          "duplicates": 0
        }
      }
    },
    {
