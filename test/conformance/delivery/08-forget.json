{
  "name": "forget",
  "spec": "HTTP.md §5",
  "capability": "forget",
  "steps": [
    {
      "send": {
        "events": [
          {
            "protocol": 1,
            "id": "*",
            "type": "session.started",
            "time": "*",
            "tier": 0,
            "harness": {
              "name": "conformance",
              "event": "test"
            },
            "session": {
              "id": "conf-{run}",
              "seq": 0
            },
            "privacy": {
              "rulesets": [
                "secrets@1"
