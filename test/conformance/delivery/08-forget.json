    {
      "send": {
        "events": [
          {
            "protocol": 1,
            "id": "*",
            "type": "session.forgotten",
            "time": "*",
            "tier": 0,
            "harness": {
              "name": "conformance",
              "event": "test"
            },
            "session": {
              "id": "conf-{run}",
              "seq": 1
            },
            "privacy": {
              "rulesets": [
                "secrets@1"
              ],
              "pii": false
            },
            "data": {}
          }
        ]
      },
      "expect": {
        "status": 202
      }
    },
    {
      "read": {
        "session": "conformance:conf-{run}"
      },
      "expect": {
        "status": 404
      }
    }
  ]
}
