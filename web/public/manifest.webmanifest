{
  "name": "sessionpipe gui",
  "short_name": "sessionpipe",
  "description": "Every coding-agent session on your machines, live; answer a prompt from your phone.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#fcfcfd",
  "theme_color": "#fcfcfd",
  "icons": [
    { "src": "/brand/mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/brand/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ]
}
