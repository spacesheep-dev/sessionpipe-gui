{
  "name": "sessionpipe-gui",
  "version": "0.7.0",
  "description": "The sessionpipe GUI: a local receiver with a live board for every coding-agent session on your machines, open from any device on your network.",
  "keywords": [
    "sessionpipe",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "antigravity",
    "cursor",
    "receiver",
    "dashboard",
    "local-first",
    "control-channel"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacesheep-dev/sessionpipe-gui.git"
  },
  "homepage": "https://github.com/spacesheep-dev/sessionpipe-gui#readme",
  "bugs": {
    "url": "https://github.com/spacesheep-dev/sessionpipe-gui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sessionpipe-gui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/build.mjs --watch",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "node scripts/build.mjs && vite build --config web/vite.config.ts",
    "build:release": "node scripts/build.mjs --require-bundle && vite build --config web/vite.config.ts",
    "prepublishOnly": "npm run build:release",
    "pack:check": "node scripts/pack-check.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "conformance": "node dist/conformance.js",
    "bench:search": "node bench/search/run.mjs",
    "prepare": "node scripts/prepare.mjs",
    "bundle:sync": "node scripts/build.mjs --sync-bundle"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "sessionpipe-core": "^0.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
